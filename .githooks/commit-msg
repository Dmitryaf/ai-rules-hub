#!/bin/sh

repo_root="$(git rev-parse --show-toplevel)" || exit 1

if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -File "$repo_root/scripts/validate-commit-message.ps1" -MessageFile "$1"
fi

if command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$repo_root/scripts/validate-commit-message.ps1" -MessageFile "$1"
fi

echo "PowerShell is required to validate commit messages." >&2
exit 1
